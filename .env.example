# Runtime connection (transaction pooler — used by the app)
DATABASE_URL=

# Migration connection (session pooler — used by prisma migrate)
DIRECT_URL=

# Supabase project URL
SUPABASE_URL=

# Supabase anon/public key
SUPABASE_ANON_KEY=

# Supabase JWT secret (Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=

# Server port
PORT=
